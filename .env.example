# Local TEST
# =====================================================
#PATCH_PLANNER_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

#RISK_ASSESSOR_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

# =====================================================
# AI
# =====================================================
ENABLE_AI_PATCH_PLANNER=true