# =====================================================
# Application
# =====================================================
APP_ENV=development

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO

# =====================================================
# Fireworks AI
# =====================================================
FIREWORKS_API_KEY=

FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# =====================================================
# Gemma Models For Production
# =====================================================
PATCH_PLANNER_MODEL=accounts/fireworks/models/gemma-3-27b-it

RISK_ASSESSOR_MODEL=accounts/fireworks/models/gemma-3-27b-it

